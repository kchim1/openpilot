# LFS objects (driving models, assets) are served anonymously from sunnypilot's public repo, so
# kchim1's repos need no LFS storage of their own. gerrylum's endpoint lacks some objects this tree
# references (big_driving_tinygrad.pkl, icons_mici/sunnylink.png); sunnypilot/sunnypilot has all of them.
[lfs]
	url = https://github.com/sunnypilot/sunnypilot.git/info/lfs
